[Unit]
Description=Tethon hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tethon
Group=tethon
EnvironmentFile=/etc/tethon/hub.env
ExecStart=/usr/local/bin/tethon-hub -addr 127.0.0.1:39180
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
