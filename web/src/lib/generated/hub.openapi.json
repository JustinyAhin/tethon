						},
						"description": "Internal Server Error"
					},
					"502": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HubStatusError"
								}
							}
						},
						"description": "Bad Gateway"
					},
					"503": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HubStatusError"
								}
							}
						},
						"description": "Service Unavailable"
					}
				},
				"summary": "Stream session events from a cursor",
				"tags": ["sessions"]
			}
		}
