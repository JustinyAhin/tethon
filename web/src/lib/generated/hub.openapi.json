		"/sessions/{host_id}/{local_id}/stream": {
			"get": {
				"operationId": "streamSession",
				"parameters": [
					{
						"in": "path",
						"name": "host_id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "path",
						"name": "local_id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"explode": false,
						"in": "query",
						"name": "from",
						"schema": {
							"default": 0,
							"format": "int64",
							"minimum": 0,
							"type": "integer"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"text/event-stream": {
								"schema": {
									"additionalProperties": false,
									"properties": {
										"created_at": {
											"format": "date-time",
											"type": "string"
										},
										"payload": {},
										"seq": {
											"format": "int64",
											"type": "integer"
										},
										"session_id": {
											"type": "string"
										},
										"type": {
											"type": "string"
										}
									},
									"required": ["session_id", "seq", "type", "created_at", "payload"],
									"type": "object"
								}
							}
						},
						"description": "Server-sent events. Each data frame contains a protocol Event."
					},
					"422": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HubStatusError"
								}
							}
						},
